c:tool-archivebox_get_archiveresult a cp:Tool ;
    cp:componentId "archivebox_get_archiveresult" ;
    cp:operatesOn :ArchiveResult ;
    cp:produces :ArchiveResult .

c:tool-archivebox_patch_archiveresult a cp:Tool ;
    cp:componentId "archivebox_patch_archiveresult" ;
    cp:operatesOn :ArchiveResult ;
    cp:produces :ArchiveResult .

c:tool-archivebox_get_tags a cp:Tool ;
    cp:componentId "archivebox_get_tags" ;
