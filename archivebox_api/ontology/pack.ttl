c:tool-web_extract a cp:Tool ;
    cp:componentId "web_extract" ;
    cp:operatesOn :WebResource ;
    cp:produces :Document .

# --- skills ------------------------------------------------------------------

c:skill-archivebox-web-archiving a cp:Skill ;
    cp:componentId "archivebox-web-archiving" ;
    cp:appliesTo :WebResource, :WebSnapshot .

c:skill-archivebox-snapshot-search a cp:Skill ;
    cp:componentId "archivebox-snapshot-search" ;
    cp:appliesTo :WebSnapshot, :ArchiveResult, :Tag .

c:skill-archivebox-kg-ingestion a cp:Skill ;
    cp:componentId "archivebox-kg-ingestion" ;
    cp:appliesTo :WebSnapshot, :ArchiveResult .

c:skill-archivebox-archive-administration a cp:Skill ;
    cp:componentId "archivebox-archive-administration" ;
    cp:appliesTo :Tag, :ArchiveCrawl, :ArchiveWorker, :CaptureBinary, :ArchivePersona .

c:skill-archivebox-research-archive a cp:Skill ;
    cp:componentId "archivebox-research-archive" ;
    cp:appliesTo :WebSnapshot, :ArchiveResult, :Tag .

c:skill-archivebox-api-operations a cp:Skill ;
    cp:componentId "archivebox-api-operations" ;
    cp:appliesTo :WebSnapshot .

c:skill-archivebox-api-development a cp:Skill ;
    cp:componentId "archivebox-api-development" ;
    cp:appliesTo :WebSnapshot .

# --- prompts (agent definitions) ---------------------------------------------

c:prompt-archivebox_operator a cp:Prompt ;
    cp:componentId "archivebox_operator" ;
    cp:appliesTo :WebSnapshot, :ArchiveCrawl, :Tag .

c:prompt-archivebox_research_archivist a cp:Prompt ;
    cp:componentId "archivebox_research_archivist" ;
    cp:appliesTo :WebSnapshot, :ArchiveResult, :Tag .

c:prompt-archivebox_archive_administrator a cp:Prompt ;
    cp:componentId "archivebox_archive_administrator" ;
    cp:appliesTo :WebSnapshot, :ArchiveCrawl, :Tag .

# --- ingest contract ---------------------------------------------------------

c:contract a cp:IngestContract ;
    cp:contractOf c:connector ;
    cp:contractVersion "2" ;
    cp:hasSourceObject c:object-snapshot, c:object-archiveresult ;
    cp:hasCursorPolicy c:cursor ;
    cp:hasAccessPolicy c:access ;
    cp:requiresProvenance c:provenance .

c:object-snapshot a cp:SourceObject ;
    rdfs:label "snapshot" ;
    rdfs:comment "ArchiveBox snapshots, ingested as :WebSnapshot." ;
    cp:hasKeyRule c:key-id .

c:object-archiveresult a cp:SourceObject ;
    rdfs:label "archive_result" ;
    rdfs:comment "ArchiveBox archive results, ingested as :ArchiveResult." ;
    cp:hasKeyRule c:key-id .

c:key-id a cp:KeyRule ;
    rdfs:label "id" ;
    rdfs:comment "Records are keyed by their ArchiveBox id (:archiveboxId)." .

c:cursor a cp:CursorPolicy ;
    cp:cursorKind "modified_at" .

c:access a cp:AccessPolicy ;
    cp:defaultAcl "quarantine" .

c:provenance a cp:ProvenanceRequirement ;
    rdfs:comment "Every ingested record carries its ArchiveBox id, source URL, capture timestamp and modified_at." .
