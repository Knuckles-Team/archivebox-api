@prefix : <https://knuckles-team.github.io/ontology/connector/archivebox#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix cp: <https://knuckles-team.github.io/ontology/connector-pack#> .
@prefix c: <https://knuckles-team.github.io/ontology/connector/archivebox#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Connector surface and ingest contract of archivebox-mcp. Tool-use contracts:
# each served tool names the domain class it reads (cp:operatesOn) and the
# class of the records it emits (cp:produces). Prompt, skill and tool links:
# each feature is realised by its tools, skills and prompts, and each skill and
# prompt names the classes it applies to. Domain classes come from
# archivebox.ttl or medulla core and roll up to core by rdfs:subClassOf.
# No blank nodes. CONN-ARCHIVEBOX-API-CONNECTOR-CONTENT-R006; keep in step with the
# served tools, skills/ and prompts/ (tests/test_surface_contracts.py).

c:connector a cp:Connector ;
    rdfs:label "ArchiveBox" ;
    cp:componentId "archivebox-mcp" ;
    cp:providesFeature c:feature-capture, c:feature-search, c:feature-administration, c:feature-kg-ingest, c:feature-research-archive ;
    cp:hasContract c:contract .

# --- features ----------------------------------------------------------------

c:feature-capture a cp:SurfaceFeature ;
    rdfs:label "Durable capture" ;
    rdfs:comment "Add URLs, crawls and snapshots to the archive, re-archive and schedule recurring captures, and file externally captured evidence as archive results." ;
    cp:realizedBy <tool://archivebox-mcp/archivebox_cli_add>, <tool://archivebox-mcp/archivebox_create_snapshot>, <tool://archivebox-mcp/archivebox_create_crawl>, <tool://archivebox-mcp/archivebox_cli_update>, <tool://archivebox-mcp/archivebox_cli_schedule>, <tool://archivebox-mcp/archivebox_patch_snapshot>, <tool://archivebox-mcp/archivebox_patch_crawl>, <tool://archivebox-mcp/archivebox_create_archiveresult>, <tool://archivebox-mcp/archivebox_patch_archiveresult>, <tool://archivebox-mcp/web_fetch>, <tool://archivebox-mcp/web_extract>,
        <skill://archivebox-web-archiving/SKILL.md>, <prompt://archivebox-mcp/archivebox_operator> .

c:feature-search a cp:SurfaceFeature ;
    rdfs:label "Archive search and evidence read" ;
    rdfs:comment "Find archived pages by URL, tag, text or time and read each snapshot's per-plugin results and exports." ;
    cp:realizedBy <tool://archivebox-mcp/archivebox_get_snapshots>, <tool://archivebox-mcp/archivebox_get_snapshot>, <tool://archivebox-mcp/archivebox_get_snapshots_rss>, <tool://archivebox-mcp/archivebox_get_archiveresults>, <tool://archivebox-mcp/archivebox_get_archiveresult>, <tool://archivebox-mcp/archivebox_get_any>, <tool://archivebox-mcp/archivebox_cli_search>, <tool://archivebox-mcp/archivebox_get_tags>, <tool://archivebox-mcp/archivebox_get_tag>, <tool://archivebox-mcp/archivebox_search_tags>, <tool://archivebox-mcp/archivebox_tags_autocomplete>, <tool://archivebox-mcp/archivebox_get_tag_urls>, <tool://archivebox-mcp/archivebox_get_tag_snapshots_jsonl>, <tool://archivebox-mcp/archivebox_get_crawls>, <tool://archivebox-mcp/archivebox_get_crawl>, <tool://archivebox-mcp/archivebox_get_crawl_file>, <tool://archivebox-mcp/archivebox_get_crawl_folder_file>, <tool://archivebox-mcp/archivebox_get_crawl_subfolder_file>,
        <skill://archivebox-snapshot-search/SKILL.md>, <prompt://archivebox-mcp/archivebox_operator>, <prompt://archivebox-mcp/archivebox_research_archivist> .

c:feature-administration a cp:SurfaceFeature ;
    rdfs:label "Archive administration" ;
    rdfs:comment "Curate tags, remove test or unwanted captures, and inspect workers, capture binaries and personas." ;
    cp:realizedBy <tool://archivebox-mcp/archivebox_create_tag>, <tool://archivebox-mcp/archivebox_rename_tag>, <tool://archivebox-mcp/archivebox_delete_tag>, <tool://archivebox-mcp/archivebox_add_tag_to_snapshot>, <tool://archivebox-mcp/archivebox_remove_tag_from_snapshot>, <tool://archivebox-mcp/archivebox_delete_snapshot>, <tool://archivebox-mcp/archivebox_delete_crawl>, <tool://archivebox-mcp/archivebox_cli_remove>, <tool://archivebox-mcp/archivebox_get_machines>, <tool://archivebox-mcp/archivebox_get_current_machine>, <tool://archivebox-mcp/archivebox_get_machine>, <tool://archivebox-mcp/archivebox_get_binaries>, <tool://archivebox-mcp/archivebox_get_binary>, <tool://archivebox-mcp/archivebox_get_binaries_by_name>, <tool://archivebox-mcp/archivebox_get_personas>, <tool://archivebox-mcp/archivebox_sync_persona>, <tool://archivebox-mcp/archivebox_get_api_token>, <tool://archivebox-mcp/archivebox_check_api_token>, <tool://archivebox-mcp/archivebox_browser_session>,
        <skill://archivebox-archive-administration/SKILL.md>, <prompt://archivebox-mcp/archivebox_operator> .

c:feature-kg-ingest a cp:SurfaceFeature ;
    rdfs:label "Knowledge graph ingest" ;
    rdfs:comment "Copy snapshots, tags, page text and archive results into the knowledge graph." ;
    cp:realizedBy <tool://archivebox-mcp/archivebox_ingest_snapshots>, <tool://archivebox-mcp/archivebox_ingest_archiveresults>,
        <skill://archivebox-kg-ingestion/SKILL.md>, <prompt://archivebox-mcp/archivebox_operator> .

c:feature-research-archive a cp:SurfaceFeature ;
    rdfs:label "Competitor and market research archive" ;
    rdfs:comment "Keep a durable, tagged, re-checkable archive of every competitor and market page a research run used, and cite it as evidence later." ;
    cp:realizedBy <tool://archivebox-mcp/archivebox_cli_add>, <tool://archivebox-mcp/archivebox_get_snapshots>, <tool://archivebox-mcp/archivebox_get_snapshot>, <tool://archivebox-mcp/archivebox_get_archiveresults>, <tool://archivebox-mcp/archivebox_create_archiveresult>, <tool://archivebox-mcp/archivebox_add_tag_to_snapshot>, <tool://archivebox-mcp/archivebox_get_tag_urls>, <tool://archivebox-mcp/archivebox_search_tags>, <tool://archivebox-mcp/archivebox_cli_update>, <tool://archivebox-mcp/archivebox_ingest_snapshots>,
        <skill://archivebox-research-archive/SKILL.md>, <prompt://archivebox-mcp/archivebox_research_archivist> .# --- tools (tool-use contracts) ----------------------------------------------
# --- skills ------------------------------------------------------------------
# --- prompts (agent definitions) ---------------------------------------------

# --- ingest contract ---------------------------------------------------------

c:contract a cp:IngestContract ;
    cp:contractOf c:connector ;
    cp:contractVersion "2" ;
    cp:hasSourceObject c:object-snapshot, c:object-archiveresult ;
    cp:hasCursorPolicy c:cursor ;
    cp:hasAccessPolicy c:access ;
    cp:requiresProvenance c:provenance .

c:object-snapshot a cp:SourceObjectMapping ;
    rdfs:label "snapshot" ;
    rdfs:comment "ArchiveBox snapshots, ingested as :WebSnapshot." ;
    cp:hasKeyRule c:key-id .

c:object-archiveresult a cp:SourceObjectMapping ;
    rdfs:label "archive_result" ;
    rdfs:comment "ArchiveBox archive results, ingested as :ArchiveResult." ;
    cp:hasKeyRule c:key-id .

c:key-id a cp:KeyRule ;
    rdfs:label "id" ;
    rdfs:comment "Records are keyed by their ArchiveBox id (:archiveboxId)." .

c:cursor a cp:CursorPolicy ;
    cp:cursorKind "modified_at" .

c:access a cp:IngestAccessPolicy ;
    cp:defaultAcl "quarantine" .

c:provenance a cp:ProvenanceRequirement ;
    rdfs:comment "Every ingested record carries its ArchiveBox id, source URL, capture timestamp and modified_at." .
