@prefix : <http://knuckles.team/kg#> .
@prefix cp: <http://knuckles.team/kg/connector-pack#> .
@prefix c: <http://knuckles.team/kg/connector/archivebox#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Connector surface and ingest contract of archivebox-mcp. Tool-use contracts:
# each served tool names the domain class it reads (cp:operatesOn) and the
# class of the records it emits (cp:produces). Prompt, skill and tool links:
# each feature is realised by its tools, skills and prompts, and each skill and
# prompt names the classes it applies to. Domain classes come from
# archivebox.ttl or medulla core and roll up to core by rdfs:subClassOf.
# No blank nodes. CONN-ARCHIVEBOX-API-CONNECTOR-CONTENT-R006; keep in step with the
# served tools, skills/ and prompts/ (tests/test_surface_contracts.py).

c:connector a cp:Connector ;
    rdfs:label "ArchiveBox" ;
    cp:componentId "archivebox-mcp" ;
    cp:providesFeature c:feature-capture, c:feature-search, c:feature-administration, c:feature-kg-ingest, c:feature-research-archive ;
    cp:hasContract c:contract .

# --- features ----------------------------------------------------------------

c:feature-capture a cp:Feature ;
    rdfs:label "Durable capture" ;
    rdfs:comment "Add URLs, crawls and snapshots to the archive, re-archive and schedule recurring captures, and file externally captured evidence as archive results." ;
    cp:realizedBy c:tool-archivebox_cli_add, c:tool-archivebox_create_snapshot, c:tool-archivebox_create_crawl, c:tool-archivebox_cli_update, c:tool-archivebox_cli_schedule, c:tool-archivebox_patch_snapshot, c:tool-archivebox_patch_crawl, c:tool-archivebox_create_archiveresult, c:tool-archivebox_patch_archiveresult, c:tool-web_fetch, c:tool-web_extract,
        c:skill-archivebox-web-archiving, c:prompt-archivebox_operator .

c:feature-search a cp:Feature ;
    rdfs:label "Archive search and evidence read" ;
    rdfs:comment "Find archived pages by URL, tag, text or time and read each snapshot's per-plugin results and exports." ;
    cp:realizedBy c:tool-archivebox_get_snapshots, c:tool-archivebox_get_snapshot, c:tool-archivebox_get_snapshots_rss, c:tool-archivebox_get_archiveresults, c:tool-archivebox_get_archiveresult, c:tool-archivebox_get_any, c:tool-archivebox_cli_search, c:tool-archivebox_get_tags, c:tool-archivebox_get_tag, c:tool-archivebox_search_tags, c:tool-archivebox_tags_autocomplete, c:tool-archivebox_get_tag_urls, c:tool-archivebox_get_tag_snapshots_jsonl, c:tool-archivebox_get_crawls, c:tool-archivebox_get_crawl, c:tool-archivebox_get_crawl_file, c:tool-archivebox_get_crawl_folder_file, c:tool-archivebox_get_crawl_subfolder_file,
        c:skill-archivebox-snapshot-search, c:prompt-archivebox_operator, c:prompt-archivebox_research_archivist .

c:feature-administration a cp:Feature ;
    rdfs:label "Archive administration" ;
    rdfs:comment "Curate tags, remove test or unwanted captures, and inspect workers, capture binaries and personas." ;
    cp:realizedBy c:tool-archivebox_create_tag, c:tool-archivebox_rename_tag, c:tool-archivebox_delete_tag, c:tool-archivebox_add_tag_to_snapshot, c:tool-archivebox_remove_tag_from_snapshot, c:tool-archivebox_delete_snapshot, c:tool-archivebox_delete_crawl, c:tool-archivebox_cli_remove, c:tool-archivebox_get_machines, c:tool-archivebox_get_current_machine, c:tool-archivebox_get_machine, c:tool-archivebox_get_binaries, c:tool-archivebox_get_binary, c:tool-archivebox_get_binaries_by_name, c:tool-archivebox_get_personas, c:tool-archivebox_sync_persona, c:tool-archivebox_get_api_token, c:tool-archivebox_check_api_token, c:tool-archivebox_browser_session,
        c:skill-archivebox-archive-administration, c:prompt-archivebox_operator .

c:feature-kg-ingest a cp:Feature ;
    rdfs:label "Knowledge graph ingest" ;
    rdfs:comment "Copy snapshots, tags, page text and archive results into the knowledge graph." ;
    cp:realizedBy c:tool-archivebox_ingest_snapshots, c:tool-archivebox_ingest_archiveresults,
        c:skill-archivebox-kg-ingestion, c:prompt-archivebox_operator .

c:feature-research-archive a cp:Feature ;
    rdfs:label "Competitor and market research archive" ;
    rdfs:comment "Keep a durable, tagged, re-checkable archive of every competitor and market page a research run used, and cite it as evidence later." ;
    cp:realizedBy c:tool-archivebox_cli_add, c:tool-archivebox_get_snapshots, c:tool-archivebox_get_snapshot, c:tool-archivebox_get_archiveresults, c:tool-archivebox_create_archiveresult, c:tool-archivebox_add_tag_to_snapshot, c:tool-archivebox_get_tag_urls, c:tool-archivebox_search_tags, c:tool-archivebox_cli_update, c:tool-archivebox_ingest_snapshots,
        c:skill-archivebox-research-archive, c:prompt-archivebox_research_archivist .

# --- tools (tool-use contracts) ----------------------------------------------

c:tool-archivebox_get_api_token a cp:Tool ;
    cp:componentId "archivebox_get_api_token" ;
    cp:operatesOn :ArchivePersona ;
    cp:produces :ArchivePersona .

c:tool-archivebox_check_api_token a cp:Tool ;
    cp:componentId "archivebox_check_api_token" ;
    cp:operatesOn :ArchivePersona ;
    cp:produces :ArchivePersona .

