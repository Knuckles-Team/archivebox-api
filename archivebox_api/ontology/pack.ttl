    cp:produces :WebSnapshot .

c:tool-archivebox_delete_snapshot a cp:Tool ;
    cp:componentId "archivebox_delete_snapshot" ;
    cp:operatesOn :WebSnapshot ;
    cp:produces :WebSnapshot .

c:tool-archivebox_get_archiveresults a cp:Tool ;
    cp:componentId "archivebox_get_archiveresults" ;
